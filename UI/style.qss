/* 基础界面设置 */
QWidget {
    background-color: #1e1e1e;  /* 深色背景 */
    color: #FFFFFF;  /* 白色字体 */
    font-family: "Segoe UI", sans-serif;
    font-size: 14px;
}

/* 窗口标题栏 */
QMainWindow::title {
    background-color: #333333;  /* 深灰色 */
    color: #00FF00;  /* 科技感绿色 */
    font-size: 18px;
    font-weight: bold;
}

/* 按钮样式 */
QPushButton {
    background-color: #3A3A3A;  /* 按钮背景色 */
    color: #00FF00;  /* 按钮文字颜色 */
    border: 2px solid #00FF00;  /* 按钮边框颜色 */
    border-radius: 5px;
    padding: 8px 16px;
    font-size: 16px;
    text-align: center;
}

QPushButton:hover {
    background-color: #00FF00;  /* 悬停时背景变为绿色 */
    color: #1e1e1e;  /* 悬停时文字变为深色 */
}

QPushButton:pressed {
    background-color: #00CC00;  /* 按下时背景颜色 */
    border: 2px solid #00CC00;  /* 按下时边框颜色 */
}

/* 输入框样式 */
QLineEdit, QTextEdit {
    background-color: #2A2A2A;  /* 输入框背景色 */
    color: #FFFFFF;  /* 输入框文字颜色 */
    border: 1px solid #3A3A3A;  /* 输入框边框颜色 */
    border-radius: 5px;
    padding: 8px;
    font-size: 14px;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #00FF00;  /* 聚焦时边框颜色 */
}

/* 标签样式 */
QLabel {
    color: #CCCCCC;  /* 标签文字颜色 */
    font-size: 14px;
}

/* 进度条样式 */
QProgressBar {
    border: 1px solid #00FF00;  /* 边框颜色 */
    border-radius: 5px;
    background-color: #1e1e1e;  /* 背景色 */
    text-align: center;
}

QProgressBar::chunk {
    background-color: #00FF00;  /* 进度条块颜色 */
    border-radius: 5px;
}

/* 复选框样式 */
QCheckBox {
    color: #CCCCCC;  /* 文字颜色 */
    font-size: 14px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 3px;
    background-color: #333333;  /* 复选框背景 */
}

QCheckBox::indicator:checked {
    background-color: #00FF00;  /* 选中时背景颜色 */
}

/* 滑块样式 */
QSlider {
    background-color: #333333;
    height: 8px;
}

QSlider::handle {
    background-color: #00FF00;  /* 滑块颜色 */
    border-radius: 5px;
    width: 20px;
    height: 20px;
}
